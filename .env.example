# Optional API keys. The app runs fully on free providers without any of these.
# Copy this file to .env.local and fill in only the keys you want to enable.
# Keys are read on the server only and are never exposed to the browser.

# AbuseIPDB — enables IP abuse score / blacklist reporting in Security & Reputation.
# Get a free key at https://www.abuseipdb.com/register (free tier: 1,000 checks/day).
ABUSEIPDB_API_KEY=

# ipinfo.io — optional enrichment (hostname / organization) and, on plans
# that include it, privacy data (VPN / proxy / Tor / hosting) for the detector.
# Get a token at https://ipinfo.io/signup (free tier available).
IPINFO_TOKEN=

# IPQualityScore — optional VPN/proxy/Tor + fraud-score signals for the
# VPN & Proxy Detector. Get a key at https://www.ipqualityscore.com/
IPQUALITYSCORE_API_KEY=

# IP2Location — optional proxy type (VPN/TOR/WEB/PUB/DCH) and usage-type
# signals for the detector. Get a key at https://www.ip2location.com/
IP2LOCATION_API_KEY=

# Abstract IP Intelligence — optional VPN/proxy/Tor/hosting security signals.
# Get a key at https://www.abstractapi.com/
ABSTRACT_API_KEY=
